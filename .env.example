# =============================================
# PostgreSQL connection settings
# Copy this file to `.env` and fill in values.
# NEVER commit the real `.env` file.
# =============================================

PGHOST=localhost
PGPORT=5432
PGDATABASE=advanced_sql_training_db
PGUSER=postgres
PGPASSWORD=postgres

# =============================================
# MongoDB connection settings
# Optional: leave MONGO_USER/MONGO_PASSWORD empty
# when the server runs without authentication.
# =============================================

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=student_db
MONGO_COLLECTION=students

# Credentials are only used when BOTH are set.
MONGO_USER=
MONGO_PASSWORD=